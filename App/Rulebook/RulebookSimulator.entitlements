<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Simulator only, via CODE_SIGN_ENTITLEMENTS[sdk=iphonesimulator*].

	     MSAL reads a teamIDHint from the keychain while building its default
	     redirect URI. Under the simulator's ad-hoc signature the app has no
	     keychain access group, so that read returns -34018
	     (errSecMissingEntitlement), MSAL raises "Failed to retrieve teamId
	     from keychain", and MSALPublicClientApplication init fails as the
	     opaque MSALErrorInternal (-50000) — the app never reaches its gate.

	     The group is written WITHOUT $(AppIdentifierPrefix): the simulator has
	     no team prefix to expand, which is the same reason the shared
	     com.microsoft.adalcache group cannot be used here.

	     Device and App Store builds deliberately carry no entitlements file.
	     The distribution profile is manual, and adding one would invalidate
	     it and break Scripts/testflight.sh. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	</array>
</dict>
</plist>
